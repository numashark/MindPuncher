{
  "rules": {
    "scores": {
      ".read": true,
      ".indexOn": ["score"],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name', 'score', 'clear'])",
        "name": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,10}$/)" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "clear": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
